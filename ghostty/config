# Ghostty Config
# Keybindings mirrored from WezTerm

# Fonts
font-family = "JetBrainsMono Nerd Font"
font-size = 15

# adjust-cell-height = 15.18%
# Window
window-padding-balance = true
unfocused-split-opacity = 1
background-opacity = 0.9
resize-overlay = always
quit-after-last-window-closed = true
confirm-close-surface = false
macos-titlebar-style = tabs
shell-integration-features = true

# Fullscreen
# macos-non-native-fullscreen = true

# Quick Terminal
quick-terminal-position = center

# Application
maximize = true

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = false
copy-on-select = clipboard
link-url = true
selection-clear-on-copy = false

# Mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1.25

# Colors
config-file = ~/.config/ghostty/colors.inc

# Keybindings

# Splits with Ctrl+Shift (vim-style)
keybind = ctrl+shift+|=new_split:right
keybind = ctrl+shift+_=new_split:down

# Pane navigation with Ctrl+Shift+hjkl (vim-style)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Tabs with Ctrl+Shift
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+[=previous_tab
keybind = ctrl+shift+]=next_tab

# Tab numbers with Cmd+1-9
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9

# Tab navigation with Cmd+arrows
keybind = cmd+left=previous_tab
keybind = cmd+right=next_tab

# Quick terminal (global keybinding)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Standard macOS bindings
keybind = super+t=new_tab
keybind = cmd+r=reload_config
keybind = cmd+i=inspector:toggle
keybind = cmd+f=toggle_fullscreen

# Copy/Paste
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+a=select_all

# Close pane with Ctrl+Shift+x
keybind = ctrl+shift+x=close_surface

