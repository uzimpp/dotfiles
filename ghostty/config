# Generated by Spectre - Ghostty Config Generator
# https://github.com/imrajyavardhan12/spectre-ghostty-config

# Fonts
font-family = "GeistMono Nerd Font"
font-size = 15

# Window
window-padding-balance = true
unfocused-split-opacity = 0.5
resize-overlay = always

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = false

# Mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# Application
app-notifications = no-clipboard-copy,config-reload
maximize = true
fullscreen = non-native
confirm-close-surface = false
quit-after-last-window-closed = true
bell-audio-volume = 0.2

# Quick-terminal
quick-terminal-position = center

# Colors
selection-clear-on-copy = true
